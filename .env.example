# Telegram
BOT_TOKEN=
ADMIN_IDS=

# Exchange environment. testnet exists; do not point these URLs at mainnet until a live launch.
XROCKET_ENV=testnet
XROCKET_REST_URL=https://exchange.api.testnet.xrocket.exchange
XROCKET_WS_URL=wss://exchange.app-api.testnet.xrocket.exchange/

# SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/autotrade.db

# Fernet key. Generate one and keep it out of git:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

LOG_LEVEL=INFO
DEFAULT_TIMEFRAME=15m
DEFAULT_RISK=medium
MAX_RETRIES=3
WS_PING_INTERVAL=30
SQLITE_BUSY_TIMEOUT=5000
SQLITE_WAL_AUTOCHECKPOINT=1000
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
COOLDOWN_MINUTES=30

# Execution. PAPER never sends orders. Real testnet orders also need ALLOW_EXCHANGE_ORDERS=true.
EXECUTION_MODE=paper
ALLOW_EXCHANGE_ORDERS=false

# "0.01" from trade-fees is read as a fraction (1%) until a tiny testnet order confirms the unit.
FEE_RATE_IS_FRACTION=true

REST_TIMEOUT_SECONDS=10
REST_MAX_RPS=2
WS_STALE_SECONDS=90
WS_RECONNECT_BASE_SECONDS=1
WS_RECONNECT_MAX_SECONDS=30

ATR_SL_MULTIPLIER=2.0
TRAILING_ACTIVATION_ATR=1.5
TRAILING_ATR_MULTIPLIER=1.5
MIN_VOLUME_RATIO=1.0
TAKE_PROFIT_RR=2.0

# Optional, only for: python -m scripts.smoke_testnet
# The smoke script is read-only. Do not commit a real token.
XROCKET_API_TOKEN=
